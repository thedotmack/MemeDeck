generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  feeTier               String        @default("default") @map("fee_tier")
  hydraFanoutId         String?       @map("hydra_fanout_id")
  hydraWalletAddress    String?       @map("hydra_wallet_address")
  lastPlatformClaim     DateTime?     @map("last_platform_claim")
  platformClaimFailures Int           @default(0) @map("platform_claim_failures")
  privyUser             Json          @map("privy_user")
  referredBy            String?       @map("referred_by")
  revSharePercentage    Int?          @default(0) @map("rev_share_percentage")
  storeData             Json          @default("{}") @map("store_data")
  userId                String        @id @map("user_id")
  partner               Partner?
  transactions          Transaction[]
  referrer              Users?        @relation("UserReferrals", fields: [referredBy], references: [userId])
  referredUsers         Users[]       @relation("UserReferrals")

  @@map("users")
}

model Partner {
  id                    String           @id @default(uuid())
  walletAddress         String?          @unique @map("wallet_address")
  partnerCode           String           @unique @map("partner_code")
  tier                  String           @default("default")
  totalEarningsLamports BigInt           @default(0) @map("total_earnings_lamports")
  totalClaimedLamports  BigInt           @default(0) @map("total_claimed_lamports")
  isActive              Boolean          @default(true) @map("is_active")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  codeCustomized        Boolean          @default(false) @map("code_customized")
  userId                String           @unique @map("user_id")
  earningsClaims        EarningsClaim[]
  feeTransactions       FeeTransaction[]
  user                  Users            @relation(fields: [userId], references: [userId])
  referrals             Referral[]

  @@map("partners")
}

model Referral {
  id                    String   @id @default(uuid())
  referrerId            String   @map("referrer_id")
  referredWalletAddress String   @unique @map("referred_wallet_address")
  referralCode          String   @map("referral_code")
  appliedAt             DateTime @default(now()) @map("applied_at")
  status                String   @default("active")
  referrer              Partner  @relation(fields: [referrerId], references: [id])

  @@index([referralCode], map: "idx_referrals_code")
  @@index([referredWalletAddress], map: "idx_referrals_wallet")
  @@map("referrals")
}

model FeeTransaction {
  id                    String   @id @default(uuid())
  tradeId               String   @map("trade_id")
  referrerId            String?  @map("referrer_id")
  tradeAmountLamports   BigInt   @map("trade_amount_lamports")
  platformFeeLamports   BigInt   @map("platform_fee_lamports")
  referrerShareLamports BigInt   @default(0) @map("referrer_share_lamports")
  userDiscountLamports  BigInt   @default(0) @map("user_discount_lamports")
  tier                  String
  createdAt             DateTime @default(now()) @map("created_at")
  feeTransactionHash    String?  @map("fee_transaction_hash")
  status                String   @default("pending")
  tradeTransactionHash  String?  @map("trade_transaction_hash")
  referrer              Partner? @relation(fields: [referrerId], references: [id])

  @@index([tradeId], map: "idx_fee_transactions_trade")
  @@index([referrerId], map: "idx_fee_transactions_referrer")
  @@index([status], map: "idx_fee_transactions_status")
  @@map("fee_transactions")
}

model EarningsClaim {
  id              String    @id @default(uuid())
  partnerId       String    @map("partner_id")
  amountLamports  BigInt    @map("amount_lamports")
  status          String    @default("pending")
  transactionHash String?   @map("transaction_hash")
  claimedAt       DateTime? @map("claimed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  partner         Partner   @relation(fields: [partnerId], references: [id])

  @@map("earnings_claims")
}

model Transaction {
  id                   String    @id @default(uuid())
  userId               String    @map("user_id")
  amountUsd            Decimal   @map("amount_usd") @db.Decimal(12, 2)
  confirmedAt          DateTime? @map("confirmed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  errorMessage         String?   @map("error_message")
  executionRequest     Json?     @map("execution_request")
  executionResponse    Json?     @map("execution_response")
  feeReceipt           String?   @map("fee_receipt")
  feeTransactionId     String?   @map("fee_transaction_id")
  feeAmountLamports    BigInt?   @map("fee_amount_lamports")
  finalTransactionHash String?   @map("final_transaction_hash")
  metadata             Json?
  status               String    @default("pending")
  tokenMint            String    @map("token_mint")
  tokenSymbol          String?   @map("token_symbol")
  transactionType      String    @map("transaction_type")
  ultraOrderRequest    Json?     @map("ultra_order_request")
  ultraOrderResponse   Json?     @map("ultra_order_response")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  walletAddress        String    @map("wallet_address")
  user                 Users     @relation(fields: [userId], references: [userId])

  @@index([userId], map: "idx_transactions_user")
  @@index([status], map: "idx_transactions_status")
  @@index([createdAt], map: "idx_transactions_created")
  @@index([finalTransactionHash], map: "idx_transactions_hash")
  @@map("transactions")
}
